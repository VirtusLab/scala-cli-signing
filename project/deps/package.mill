package build.project.deps

import mill.*
import mill.scalalib.*

import java.util.Locale

import scala.util.Properties

object Java {
  // the JDK Mill runs on & compiles with, also used as the GraalVM Java version for native images
  def buildJava = 25
  // the Java version targeted by the produced bytecode & JDK API (via -java-output-version / --release)
  def outputJava = 17
}

object Deps {
  object Versions {
    def bouncycastle    = "1.87"
    def caseApp         = "2.2.0"
    def scalaPublish    = "1.0.0"
    def coursierVersion = "2.1.26"
    def graalVmVersion  = s"${Java.buildJava}.0.2"
    // there are no GraalVM CE builds for macOS x64 past 25.0.1
    def graalVmMacosX64Version = s"${Java.buildJava}.0.1"
    def graalVmId              = {
      val isArm   = sys.props.getOrElse("os.arch", "").toLowerCase(Locale.ROOT) == "aarch64"
      val version =
        if Properties.isMac && !isArm then graalVmMacosX64Version
        else graalVmVersion
      s"graalvm-community:$version"
    }
    def expecty             = "0.17.1"
    def jsoniterScala       = "2.42.3"
    def munit               = "1.3.6"
    def osLib               = "0.11.10"
    def ubuntuDockerVersion = "ubuntu:24.04"
    def ujson               = "4.4.3"
    def sttpClient4         = "4.0.27"
  }
  def bouncycastle      = mvn"org.bouncycastle:bcpg-jdk18on:${Versions.bouncycastle}"
  def bouncycastleUtils = mvn"org.bouncycastle:bcutil-jdk18on:${Versions.bouncycastle}"
  def caseApp           = mvn"com.github.alexarchambault::case-app:${Versions.caseApp}"
  def scalaPublish      = mvn"org.scala-lang::scala-publish:${Versions.scalaPublish}"
  def expecty           = mvn"com.eed3si9n.expecty::expecty:${Versions.expecty}"
  def jsoniterCore      =
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-core:${Versions.jsoniterScala}"
  def jsoniterMacros =
    mvn"com.github.plokhotnyuk.jsoniter-scala::jsoniter-scala-macros:${Versions.jsoniterScala}"
  def munit = mvn"org.scalameta::munit:${Versions.munit}"
  def osLib = mvn"com.lihaoyi::os-lib:${Versions.osLib}"

  // used by the meta-build (mill-build/build.mill)
  def millScalafix                  = mvn"com.goyeau::mill-scalafix::0.6.0"
  def sonatypeCentralClientRequests =
    mvn"com.lumidion::sonatype-central-client-requests:0.6.0"
  def sttpClient4 = mvn"com.softwaremill.sttp.client4::core:${Versions.sttpClient4}"
  def ujson       = mvn"com.lihaoyi::ujson:${Versions.ujson}"

}

object Scala {
  def scala3 = "3.9.0"
}
